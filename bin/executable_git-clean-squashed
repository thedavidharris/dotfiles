#!/usr/bin/env bash
# =============================================================================
# Git Clean Squashed Branches
# Deletes branches that were squash-merged into a target branch
# =============================================================================

set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not a git repository." >&2
  exit 1
fi

git fetch --prune

if [[ $# -gt 0 ]]; then
  git delete-squashed-branches "$@"
else
  git delete-squashed-branches "$(git main-branch)"
fi
