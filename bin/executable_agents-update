#!/usr/bin/env bash
# =============================================================================
# Agents Update
# Pull the latest dot_agents (and work overlay) and reinstall skills/MCP servers
# =============================================================================

set -euo pipefail

targets=("$HOME/.agents")
[[ -d "$HOME/.agents-work" ]] && targets+=("$HOME/.agents-work")

chezmoi apply --refresh-externals=always "${targets[@]}"
chezmoi execute-template < "$(chezmoi source-path)/.chezmoiscripts/run_after_30-agents.sh.tmpl" | bash
