{{ if and (ne .chezmoi.os "windows") (index . "installAgents") -}}
#!/bin/bash

# Compose ~/.agents/agents.toml from the base config (plus the work overlay on
# work machines) and run dotagents install when the result changed.

set -euo pipefail

{{ template "brew-shellenv.sh" . }}

# Match the shell identity even when apply runs from zsh during bootstrap.
export EMAIL={{ .email | shellQuote }}
{{ if .isWork -}}
export WORK_EMAIL={{ .workEmail | shellQuote }}
{{ else -}}
unset WORK_EMAIL
{{ end -}}

AGENTS_DIR="$HOME/.agents"
BASE="$AGENTS_DIR/agents.base.toml"
TARGET="$AGENTS_DIR/agents.toml"
INSTALLED="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/agents-v3-installed.toml"
COMPOSED="$(mktemp)"
trap 'rm -f "$COMPOSED"' EXIT

if [[ ! -f "$BASE" ]]; then
    echo >&2 "$BASE not found. Configure GitHub SSH access, then rerun chezmoi apply."
    exit 1
fi

cat "$BASE" > "$COMPOSED"
# An identity change can affect environment-backed work configuration at install time.
printf '\n# Machine identity: {{ dict "email" .email "isWork" .isWork | toJson | sha256sum }}\n' >> "$COMPOSED"
{{ if .isWork -}}
WORK="$HOME/.agents-work/agents.work.toml"
if [[ -f "$WORK" ]]; then
    printf '\n' >> "$COMPOSED"
    cat "$WORK" >> "$COMPOSED"
else
    echo >&2 "$WORK not found. Check access to the work overlay, then rerun chezmoi apply."
    exit 1
fi
{{ end -}}

if cmp -s "$COMPOSED" "$TARGET" && cmp -s "$COMPOSED" "$INSTALLED"; then
    exit 0
fi

cp "$COMPOSED" "$TARGET"
# Use mise's Node even when chezmoi was launched from a fresh zsh session.
# Run from HOME so a caller's project config cannot select a different runtime.
cd "$HOME"
mise install node
echo "Installing agent skills and MCP servers..."
mise exec node -- npx -y @sentry/dotagents@3 --user install

# Record success only after installation. A failed apply must retry next time.
mkdir -p "$(dirname "$INSTALLED")"
cp "$COMPOSED" "$INSTALLED"
{{ end -}}
