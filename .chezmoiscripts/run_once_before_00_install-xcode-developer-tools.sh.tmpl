{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

# Full Xcode and standalone Command Line Tools both satisfy this prerequisite.
if ! /usr/bin/xcrun --find clang >/dev/null 2>&1; then
    /usr/bin/xcode-select --install || true
    echo >&2 "Finish installing Xcode Command Line Tools, then rerun chezmoi apply."
    exit 1
fi
{{ end -}}
