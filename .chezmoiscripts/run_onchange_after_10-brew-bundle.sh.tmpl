{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash

# Re-run when this machine's rendered Brewfile changes.
# Brewfile hash: {{ includeTemplate "dot_config/brew/Brewfile.tmpl" . | sha256sum }}

set -euo pipefail

{{ template "brew-shellenv.sh" . }}

if ! command -v brew >/dev/null 2>&1; then
    echo >&2 "Install Homebrew from https://brew.sh/ and rerun chezmoi apply."
    exit 1
fi

brew bundle install --no-upgrade --file="$HOME/.config/brew/Brewfile"
{{ end -}}
