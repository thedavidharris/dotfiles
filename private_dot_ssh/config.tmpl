{{- $sshAgentSock := index . "ssh_agent_sock" -}}
{{- if $sshAgentSock -}}
Host *
  IdentityAgent {{ $sshAgentSock | quote }}
{{- else if eq .chezmoi.os "darwin" -}}
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else -}}
# Use the system OpenSSH agent (SSH_AUTH_SOCK) by default.
{{- end }}
