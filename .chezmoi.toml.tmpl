{{- $isWork := promptBoolOnce . "isWork" "Is this a work machine" false -}}
{{- $configureMacOS := promptBoolOnce . "configureMacOS" "Apply macOS system preferences (optional)" false -}}
[data]
    isWork = {{ $isWork }}
    configureMacOS = {{ $configureMacOS }}

# Shared identity, theme, and tool defaults live in .chezmoidata/data.yaml.
# Add machine-specific overrides under [data] above, or in [data.tools].

[add]
    secrets = "error"
